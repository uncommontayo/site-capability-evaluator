# Where the Catalog API lives. In local dev: run `python scripts/serve_catalog.py`
# (serves fixtures/catalog.json on :8000) and point this at it.
CATALOG_BASE=http://localhost:8000

# LLM provider/model - never hard-coded in code.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=

# "recorded" (default) replays fixed cassette responses from tests/cassettes/ - zero
# network calls, zero cost, zero flake. Safe default so the service boots without a
# key. Set to "anthropic" to make real calls.
LLM_CLIENT=recorded

EVALUATOR_VERSION=0.1.0
CATALOG_CACHE_TTL_SECONDS=300
# Retry+backoff on transient catalog fetch failures (connection errors, timeouts,
# 5xx). A confirmed 404 is never retried - see app/catalog.py.
CATALOG_RETRY_ATTEMPTS=3
CATALOG_RETRY_BASE_DELAY_SECONDS=0.2

# Bounds how many feature-cluster LLM calls run concurrently per evaluation.
# Clusters are independent, so concurrency is safe; unbounded concurrency on the
# real ~12-cluster catalog would fire a burst of simultaneous requests at the
# LLM provider on every single evaluation.
LLM_MAX_CONCURRENT_CLUSTERS=4

# Cost estimation is opt-in and zero by default - we don't hard-code a $/token
# figure that could go stale. Set these to your provider's current published
# rate (USD per 1,000,000 tokens) if you want /internal/guardrail-metrics to
# report an estimated cost.
LLM_INPUT_COST_PER_MILLION_TOKENS=0.0
LLM_OUTPUT_COST_PER_MILLION_TOKENS=0.0

PORT=8080
